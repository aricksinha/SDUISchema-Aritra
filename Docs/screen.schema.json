{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/sdui/screen.schema.json",
  "title": "SDUI Screen — structural contract v1",
  "description": "Validates the STRUCTURE only (Screen/Node shape). Node `type`, style token names, and action ids are an open, evolving vocabulary and are intentionally left as free-form strings here — validating them is a separate, softer lint step, not a structural gate. This file should run in backend CI before every screen payload publish.",
  "type": "object",
  "required": ["screenId", "structureVersion", "root"],
  "additionalProperties": true,
  "properties": {
    "screenId": { "type": "string", "minLength": 1 },
    "structureVersion": { "type": "integer", "minimum": 1 },
    "components": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/node" }
    },
    "root": { "$ref": "#/definitions/node" }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "style": { "$ref": "#/definitions/styleRef" },
        "layout": { "$ref": "#/definitions/layout" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/node" }
        },
        "actionId": { "type": "string" },
        "dataBinding": { "type": "string" },
        "accessibility": { "type": "object" },
        "analytics": { "type": "object" },
        "props": {}
      }
    },
    "styleRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backgroundColorToken": { "type": "string" },
        "textColorToken": { "type": "string" },
        "fontToken": { "type": "string" },
        "paddingToken": { "type": "string" },
        "radiusToken": { "type": "string" },
        "borderColorToken": { "type": "string" }
      }
    },
    "layout": {
      "type": "object",
      "required": ["direction"],
      "additionalProperties": false,
      "properties": {
        "direction": { "type": "string", "enum": ["horizontal", "vertical", "overlay"] },
        "alignment": { "type": "string", "enum": ["leading", "center", "trailing", "top", "bottom"] },
        "spacingToken": { "type": "string" },
        "weight": { "type": "number" }
      }
    }
  }
}
